{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/AcceptanceMeter/**",
              "components/AgentAvatar/**",
              "components/AgentState/**",
              "components/AutoRelease/**",
              "components/Badge/**",
              "components/Banner/**",
              "components/Button/**",
              "components/Card/**",
              "components/ChatPager/**",
              "components/Checkbox/**",
              "components/CodeBlock/**",
              "components/Composer/**",
              "components/ContextGauge/**",
              "components/DayBars/**",
              "components/Dialog/**",
              "components/DocDiff/**",
              "components/EmptyState/**",
              "components/FileDrop/**",
              "components/GoalRow/**",
              "components/Icon/**",
              "components/AssignmentRef/**",
              "components/AssignmentRow/**",
              "components/AssignmentState/**",
              "components/ListRow/**",
              "components/Menu/**",
              "components/Message/**",
              "components/NavItem/**",
              "components/NodeChip/**",
              "components/NodeRow/**",
              "components/OrgMark/**",
              "components/OrgSwitcher/**",
              "components/PersonAvatar/**",
              "components/Progress/**",
              "components/Prose/**",
              "components/QueueRow/**",
              "components/RankedBars/**",
              "components/Readouts/**",
              "components/Select/**",
              "components/Skeleton/**",
              "components/SubagentGroup/**",
              "components/SubagentTask/**",
              "components/Switch/**",
              "components/Table/**",
              "components/Tabs/**",
              "components/Text/**",
              "components/TextField/**",
              "components/Thinking/**",
              "components/Toast/**",
              "components/ToolCall/**",
              "components/Tooltip/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AcceptanceMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:satisfied|claimed|unclaimed|compact|key|ref|className|style|children)$/]",
        "message": "<AcceptanceMeter> doesn't accept that prop. Declared props: satisfied, claimed, unclaimed, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|name|role|color|initials|size|key|ref|className|style|children)$/]",
        "message": "<AgentAvatar> doesn't accept that prop. Declared props: className, name, role, color, initials, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentState'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|state|label|compact|key|ref|className|style|children)$/]",
        "message": "<AgentState> doesn't accept that prop. Declared props: className, state, label, compact."
      },
