        "selector": "JSXOpeningElement[name.name='AutoRelease'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|stops|variant|label|className|key|ref|className|style|children)$/]",
        "message": "<AutoRelease> doesn't accept that prop. Declared props: value, onChange, stops, variant, label, className."
      },
