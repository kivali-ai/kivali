# The updater's development signing key. Release builds use the project
# owner's key, which never lives in the repository (docs/developers/desktop-app.md).
/.keys/
/node_modules/
/dist/
/src-tauri/target/
/src-tauri/gen/
# build.rs writes these from its command list on every build.
/src-tauri/permissions/autogenerated/
# The sidecar is a build output: `make sidecar` writes it.
/src-tauri/binaries/
/fake-supervisor/target/
