{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell-pages",
  "description": "IPC for the pages bundled in the app (setup, settings, and each team window's Kivali page), and nowhere else. There is deliberately no `remote` entry and no team `web-*` webview: a team's served web app, here or elsewhere, gets no IPC at all (docs/developers/desktop-app.md, Capabilities).",
  "local": true,
  "windows": [
    "setup",
    "settings"
  ],
  "webviews": [
    "setup",
    "settings",
    "page-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-shell-snapshot",
    "allow-set-title",
    "allow-close-window",
    "allow-open-settings",
    "allow-open-setup",
    "allow-owner-signin-start",
    "allow-owner-signin-reset",
    "allow-prepare-team",
    "allow-discard-prepared",
    "allow-create-team",
    "allow-open-claude-signin",
    "allow-credential-setup",
    "allow-apply-credential-setup",
    "allow-finish-setup",
    "allow-abandon-team",
    "allow-retry-create",
    "allow-connect-check",
    "allow-connect-signin",
    "allow-connect-reset",
    "allow-open-team",
    "allow-open-team-page",
    "allow-pause-team",
    "allow-resume-team",
    "allow-retry-team",
    "allow-pause-and-resume",
    "allow-update-team",
    "allow-open-in-browser",
    "allow-remove-team",
    "allow-delete-team",
    "allow-team-facts",
    "allow-set-resources",
    "allow-set-public-url",
    "allow-sign-out-team",
    "allow-reorder-teams",
    "allow-set-setting",
    "allow-check-app-update",
    "allow-install-app-update",
    "allow-open-logs",
    "allow-open-config-dir",
    "allow-save-diagnostics",
    "allow-open-external"
  ]
}
