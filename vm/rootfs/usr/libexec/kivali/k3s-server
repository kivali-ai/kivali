#!/bin/sh
# Runs k3s server for the life of the VM (busybox init `once`). Its
# log goes to the data disk; the previous boot's log is kept as .1.
#
# The node object in k3s's datastore keeps the address the node had
# when k3s last ran. When this boot's address differs (a new DHCP
# lease), kube-router's network policy controller can read the old
# address before the kubelet and the cloud controller replace it, find
# no interface carrying it, and k3s exits. So when the address is not
# the one recorded in $NODE_IP (or nothing is recorded and a datastore
# exists), k3s first runs without its agent (no kubelet, no pods, no
# network policy controller) while the node object's addresses and
# address annotations are set to this boot's address, then stops, and
# only then starts normally. /run/kivali/k3s-started marks the normal
# start; `ready` waits for it. A clean shutdown meanwhile
# (/run/kivali/stopping) ends this script quietly: no FATAL, no start.
export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
exec </dev/null

DATA=/var/lib/kivali
LOG=$DATA/log/k3s.log
# The node address k3s last started with.
NODE_IP=$DATA/node-ip
# How long the agentless start may take to update the node object.
REPAIR_S=120

say() { echo "KIVALI-VM: $*"; }
fatal() {
  echo "KIVALI-VM FATAL: $*"
  echo "$*" > /run/kivali/fatal 2>/dev/null
  sync
  exec poweroff
}

if [ ! -e /run/kivali/booted ]; then
  echo "KIVALI-VM FATAL: k3s: boot did not complete; not starting k3s"
  echo "k3s: boot did not complete; not starting k3s" > /run/kivali/fatal 2>/dev/null
  sync
  exec poweroff -f
fi

# Rotate: keep the previous boot's log as k3s.log.1.
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1"
say "k3s: starting $(k3s --version | head -n 1), log $LOG"

# --prefer-bundled-bin: the root has no iptables/mount helpers of its
# own beyond busybox; k3s's bundled userspace is used instead.
set -- \
  --data-dir="$DATA/k3s" \
  --disable=traefik,servicelb,metrics-server \
  --node-name=kivali \
  --write-kubeconfig-mode=0600 \
  --prefer-bundled-bin

# This boot's address, as k3s picks it: the address of the interface
# the default route uses.
dev=$(ip -4 route show default | awk '{for (i = 1; i < NF; i++) if ($i == "dev") {print $(i + 1); exit}}')
ip=''
[ -n "$dev" ] && ip=$(ip -4 -o addr show dev "$dev" scope global | awk '{split($4, a, "/"); print a[1]; exit}')
last=$(cat "$NODE_IP" 2>/dev/null)

# A request the API server accepts but stalls on gives up after 10 s,
# so the repair loop below keeps to its deadline.
kc() { k3s kubectl --request-timeout=10s "$@"; }
stopping() { [ -e /run/kivali/stopping ]; }

# set_node_ip: the node object's InternalIP and address annotations
# become $ip. With no node object (k3s never registered the node) there
# is nothing to update, and node_missing is set. Any other error,
# including a NotFound for the API resource while the API server is
# still starting, fails, as does everything until the API server
# answers.
node_missing=''
set_node_ip() {
  if ! list=$(kc get node kivali -o jsonpath='{range .status.addresses[*]}{.type}={.address}{" "}{end}' 2>/run/kivali/k3s-repair.err); then
    grep -qF 'nodes "kivali" not found' /run/kivali/k3s-repair.err || return 1
    node_missing=1
    return 0
  fi
  kc annotate node kivali --overwrite \
    "alpha.kubernetes.io/provided-node-ip=$ip" \
    "k3s.io/internal-ip=$ip" \
    "flannel.alpha.coreos.com/public-ip=$ip" >/dev/null 2>&1 || return 1
  addrs="{\"type\":\"InternalIP\",\"address\":\"$ip\"}"
  for a in $list; do
    case "$a" in
      InternalIP=*) ;;
      *=*) addrs="$addrs,{\"type\":\"${a%%=*}\",\"address\":\"${a#*=}\"}" ;;
    esac
  done
  kc patch node kivali --subresource=status --type=merge \
    -p "{\"status\":{\"addresses\":[$addrs]}}" >/dev/null 2>&1 || return 1
  [ "$(kc get node kivali -o jsonpath='{.status.addresses[?(@.type=="InternalIP")].address}' 2>/dev/null)" = "$ip" ]
}

# stop <pid>: SIGTERM, up to 30 s, then SIGKILL.
stop() {
  kill -TERM "$1" 2>/dev/null
  n=0
  while kill -0 "$1" 2>/dev/null && [ "$n" -lt 300 ]; do usleep 100000; n=$((n + 1)); done
  kill -KILL "$1" 2>/dev/null
  wait "$1" 2>/dev/null
}

if [ -n "$ip" ] && [ "$ip" != "$last" ] && [ -e "$DATA/k3s/server/db/state.db" ]; then
  say "k3s: node address ${last:-not recorded}, now $ip; updating the node object with k3s's agent disabled"
  k3s server "$@" --disable-agent >>"$LOG" 2>&1 &
  pid=$!
  # shutdown stops this k3s if the VM is stopped meanwhile.
  echo "$pid" > /run/kivali/k3s.pid
  deadline=$(($(cut -d. -f1 /proc/uptime) + REPAIR_S))
  until set_node_ip; do
    # A shutdown stops this k3s itself; that is not a failure.
    stopping && exit 0
    kill -0 "$pid" 2>/dev/null || fatal "k3s: k3s exited while updating the node address to $ip (see $LOG)"
    [ "$(cut -d. -f1 /proc/uptime)" -ge "$deadline" ] && fatal "k3s: could not update the node address to $ip within ${REPAIR_S}s (see $LOG)"
    sleep 1
  done
  stop "$pid"
  stopping && exit 0
  if [ -n "$node_missing" ]; then
    say "k3s: no node object yet; nothing to update"
  else
    say "k3s: node address updated to $ip"
  fi
fi
# Recorded only once the node object carries this address (or there is
# none yet, and k3s registers it with this address). sync first, so the
# datastore's update is on disk before the address is; the address is
# written to a temporary file and renamed, so it is never partial.
if [ -n "$ip" ] && [ "$ip" != "$last" ]; then
  sync
  echo "$ip" > "$NODE_IP.tmp" && mv -f "$NODE_IP.tmp" "$NODE_IP"
fi

stopping && exit 0
echo $$ > /run/kivali/k3s.pid
: > /run/kivali/k3s-started
exec k3s server "$@" >>"$LOG" 2>&1
